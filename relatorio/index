function status(sec){const G=S.ger,Q=S.guest;
 const full=a=>a.every(r=>r.orc!=null&&r.real!=null);
 switch(sec){
  case 'dreMes':return full(G.dreMes)?'ok':'warn';case 'dreAno':return full(G.dreAno)?'ok':'warn';
  case 'despMes':return full(G.despMes)?'ok':'warn';case 'despAno':return full(G.despAno)?'ok':'warn';
  case 'cs':return G.cs1.length&&G.cs2.length?'ok':'warn';case 'prev':return G.prev.every(p=>p.occ[0]!=null)?'ok':'warn';
  case 'man':return G.man.bl.some(b=>b.f.length)?(G.man.bl.some(b=>!b.f.length)?'warn':'ok'):'warn';
  case 'eq':return 'ok';case 'crm':return S.crm?'ok':'warn';
  case 'rep':return Q.rep.nps.every(r=>r[0]!=null)?'ok':'warn';
  case 'prints':return Object.values(Q.pr).every(a=>a.length)?'ok':'warn';
  case 'cli':return Q.cli.some(b=>b.f.length)?(Q.cli.some(b=>!b.f.length)?'warn':'ok'):'warn';
