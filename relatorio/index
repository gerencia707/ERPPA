<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Relatório Mensal · ERPPA</title>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">
<style>
:root{--dk:#0A2A22;--dk2:#12443F;--lt:#C7F1C5;--sg:#A1E19C;--bg:#F0F5FA;--ink:#1c2b27;--mut:#62736d;--line:#d6e1de;--red:#B83227;--grn:#1D7A4C;--warn:#C77700;--app:#E9EFED}
*{box-sizing:border-box}
html,body{margin:0}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:var(--app);font-size:14px}
button,input,select,textarea{font:inherit;color:inherit}
/* ---------- topo ---------- */
.top{position:sticky;top:0;z-index:20;background:var(--dk);color:#fff;display:flex;align-items:center;gap:20px;padding:0 20px;height:60px}
.top img{height:20px}
.top .ttl{font-family:Archivo,sans-serif;font-size:15px;opacity:.85;border-left:1px solid rgba(255,255,255,.25);padding-left:16px}
.top .per{display:flex;gap:6px;align-items:center}
.top select{background:var(--dk2);border:1px solid rgba(255,255,255,.2);color:#fff;border-radius:6px;padding:5px 8px}
.tabs{display:flex;gap:4px;margin-left:auto}
.tabs button{background:transparent;border:0;color:rgba(255,255,255,.75);padding:8px 14px;border-radius:7px;cursor:pointer;font-weight:500}
.tabs button.on{background:var(--lt);color:var(--dk)}
.tabs button:hover:not(.on){background:rgba(255,255,255,.08)}
.menu{position:relative}
.menu>button{background:transparent;border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:7px;padding:7px 12px;cursor:pointer}
.menu .dd{display:none;position:absolute;right:0;top:42px;background:#fff;color:var(--ink);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.18);min-width:260px;padding:6px;z-index:30}
.menu.open .dd{display:block}
.dd button{display:block;width:100%;text-align:left;background:none;border:0;padding:9px 12px;border-radius:7px;cursor:pointer}
.dd button:hover{background:var(--bg)}
.dd hr{border:0;border-top:1px solid var(--line);margin:4px 0}
/* ---------- layout ---------- */
.wrap{display:flex;min-height:calc(100vh - 60px)}
aside{width:250px;flex:none;background:#fff;border-right:1px solid var(--line);padding:16px 10px}
aside h4{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:6px 10px 10px}
aside button{display:flex;align-items:center;gap:10px;width:100%;text-align:left;background:none;border:0;padding:9px 10px;border-radius:7px;cursor:pointer;color:var(--ink)}
aside button.on{background:var(--bg);font-weight:600}
aside button:hover:not(.on){background:#f6f9f8}
.dot{width:8px;height:8px;border-radius:50%;flex:none;background:#cbd5d2}
.dot.ok{background:var(--grn)}.dot.pend{background:#cbd5d2}.dot.warn{background:var(--warn)}
.who{margin:18px 10px 0;padding:12px;border-radius:8px;background:var(--bg);font-size:12px;color:var(--mut);line-height:1.5}
main{flex:1;min-width:0;padding:24px 28px 60px}
.card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px;margin-bottom:18px}
.card h3{font-family:Archivo,sans-serif;font-weight:500;font-size:20px;margin:0 0 4px;color:var(--dk)}
.card .sub{color:var(--mut);margin:0 0 16px;font-size:13px;line-height:1.5}
.card h5{margin:18px 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--mut)}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
.fld{display:flex;flex-direction:column;gap:5px;min-width:120px}
.fld label{font-size:12px;color:var(--mut);font-weight:500}
input[type=text],input[type=number],textarea,select.in{border:1px solid var(--line);border-radius:7px;padding:8px 10px;background:#fff;width:100%}
input:focus,textarea:focus{outline:2px solid var(--sg);border-color:var(--sg)}
textarea{resize:vertical;min-height:70px;line-height:1.5}
.btn{background:var(--dk);color:#fff;border:0;border-radius:7px;padding:9px 14px;cursor:pointer;font-weight:500}
.btn:hover{background:var(--dk2)}
.btn.ghost{background:#fff;color:var(--dk);border:1px solid var(--line)}
.btn.ghost:hover{background:var(--bg)}
.btn.sm{padding:6px 10px;font-size:12.5px}
.btn.lt{background:var(--lt);color:var(--dk)}
.msg{font-size:13px;margin-top:10px;padding:9px 12px;border-radius:7px;background:var(--bg);display:none}
.msg.show{display:block}
.msg.ok{background:#e4f6e7;color:#1b5e36}.msg.err{background:#fbe9e7;color:#8a2a1f}
/* tabela editável */
.tb{width:100%;border-collapse:collapse;font-size:13px}
.tb th{font-size:11.5px;text-align:right;color:var(--mut);font-weight:600;padding:6px 6px;border-bottom:1px solid var(--line);white-space:nowrap}
.tb th:first-child{text-align:left}
.tb td{padding:3px 6px;border-bottom:1px solid #eef3f1;white-space:nowrap}
.tb td.lb{font-weight:600;font-size:12px}
.tb td input{text-align:right;padding:5px 8px;min-width:110px}
.tb td input.tx{text-align:left}
.tb td.cv{text-align:right;color:var(--mut);font-variant-numeric:tabular-nums}
.tb td.cv.good{color:var(--grn)}.tb td.cv.bad{color:var(--red)}
.tb tr.auto td{background:#f6faf9}
.tbw{overflow-x:auto}
.paste{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:start}
.paste textarea{min-height:64px;font-family:ui-monospace,Consolas,monospace;font-size:12px}
.paste .col{display:flex;flex-direction:column;gap:6px}
/* fotos */
.blk{border:1px solid var(--line);border-radius:10px;padding:14px;margin-bottom:12px;background:#fbfdfc}
.blk.drag{outline:2px dashed var(--sg);background:#f0fbf0}
.blk-h{display:flex;gap:8px;align-items:center;margin-bottom:10px}
.blk-h input{flex:1}
.blk-h .n{font-size:12px;color:var(--mut);white-space:nowrap}
.ths{display:flex;flex-wrap:wrap;gap:10px}
.th{width:170px;background:#fff;border:1px solid var(--line);border-radius:9px;overflow:hidden}
.th .im{height:110px;background:#e7ecea center/cover no-repeat;position:relative}
.th .ctl{position:absolute;top:6px;right:6px;display:flex;gap:4px}
.th .ctl button{width:24px;height:24px;border-radius:6px;border:0;background:rgba(10,42,34,.75);color:#fff;cursor:pointer;font-size:13px;line-height:1}
.th input{border:0;border-top:1px solid var(--line);border-radius:0;font-size:12px;padding:7px 8px}
.add{width:170px;min-height:110px;border:1.5px dashed #b9c9c4;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;color:var(--mut);cursor:pointer;font-size:12.5px;text-align:center;padding:10px;background:#fff}
.add:hover{border-color:var(--dk2);color:var(--dk)}
.add input{display:none}
.add b{font-size:22px;font-weight:400;line-height:1}
/* pessoas */
.ppl{display:flex;flex-direction:column;gap:8px}
.pp{display:grid;grid-template-columns:56px 1fr 1fr auto;gap:10px;align-items:center}
.pp .av{width:56px;height:56px;border-radius:8px;background:#e7ecea center/cover no-repeat;border:1px dashed #b9c9c4;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--mut);position:relative;overflow:hidden}
.pp .av input{display:none}
.x{background:none;border:0;color:var(--mut);cursor:pointer;font-size:18px;padding:4px 8px;border-radius:6px}
.x:hover{background:#fbe9e7;color:var(--red)}
.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.hint{font-size:12px;color:var(--mut);margin-top:6px}
.lnk{background:none;border:0;color:var(--dk2);text-decoration:underline;cursor:pointer;padding:0;font-size:12px}
/* revisão */
.rv-bar{display:flex;align-items:center;gap:14px;flex-wrap:wrap;background:#fff;border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin-bottom:18px}
.seg{display:flex;background:var(--bg);border-radius:8px;padding:3px}
.seg button{border:0;background:none;padding:7px 14px;border-radius:6px;cursor:pointer;font-weight:500;color:var(--mut)}
.seg button.on{background:#fff;color:var(--dk);box-shadow:0 1px 3px rgba(0,0,0,.08)}
.rv-bar .info{color:var(--mut);font-size:13px}
.rv-bar .btn{margin-left:auto}
.checks{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.chk{background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 12px;font-size:12.5px;display:flex;gap:8px;align-items:center;cursor:pointer}
.pv{display:grid;grid-template-columns:repeat(auto-fill,minmax(400px,1fr));gap:18px}
.pv-it{background:#fff;border-radius:10px;padding:8px;border:1px solid var(--line);cursor:zoom-in}
.pv-sc{position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;border-radius:6px}
.pv-sc .slide{position:absolute;left:0;top:0;transform-origin:0 0}
.pv-it .pn{font-size:11.5px;color:var(--mut);padding:6px 4px 0;display:flex;justify-content:space-between}
.lbx{position:fixed;inset:0;background:rgba(5,20,16,.85);z-index:50;display:none;align-items:center;justify-content:center}
.lbx.show{display:flex}
.lbx .pv-sc{width:min(92vw,160vh);border-radius:8px}
.lbx .nav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.12);border:0;color:#fff;width:46px;height:46px;border-radius:50%;cursor:pointer;font-size:22px}
.lbx .nav.l{left:20px}.lbx .nav.r{right:20px}
.lbx .cl{position:absolute;top:16px;right:20px;background:none;border:0;color:#fff;font-size:28px;cursor:pointer}
.lbx .ct{position:absolute;bottom:16px;color:rgba(255,255,255,.7);font-size:13px}

/* ================= SLIDES (1280x720) ================= */
.slide{width:1280px;height:720px;position:relative;overflow:hidden;background:var(--bg);font-family:Inter,system-ui,sans-serif;color:#1d2b27;-webkit-print-color-adjust:exact;print-color-adjust:exact}
.slide .sh{position:absolute;left:56px;right:56px;top:38px;display:flex;align-items:center;gap:14px;padding-bottom:20px;border-bottom:1px solid #cfdcd8}
.slide .sh svg{width:30px;height:30px;color:var(--dk2);flex:none}
.slide .sh h2{margin:0;font-family:Archivo,Inter,sans-serif;font-weight:400;font-size:38px;color:var(--dk2);letter-spacing:-.005em}
.slide .chip{background:var(--lt);color:var(--dk);font-size:11.5px;font-weight:600;padding:6px 11px;border-radius:6px}
.slide .chip.pl{background:none;padding:6px 4px}
.slide .bd{position:absolute;left:56px;right:56px;top:128px;bottom:58px}
.slide .flogo{position:absolute;right:52px;bottom:22px;width:84px;opacity:.85}
.slide .note{position:absolute;left:56px;bottom:26px;font-size:12px;color:#40524d}
.slide .note b{font-style:italic}
/* tabelas slide */
.st{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.st thead th{background:var(--dk);color:#fff;font-weight:600;font-size:11.5px;padding:6px 10px;text-align:right;line-height:1.25}
.st thead th:first-child{text-align:left}
.st thead tr.tcap th{text-align:center;font-size:12.5px;letter-spacing:.02em;border-bottom:1px solid rgba(255,255,255,.18)}
.st td{padding:6.5px 10px;text-align:right;border-bottom:1px solid #dde7e4;background:#fff;white-space:nowrap}
.st td:first-child{text-align:left;font-weight:600;font-size:11.5px;background:#fff}
.st tr.hl td:first-child{background:var(--lt)}
.st tr.tot td{background:var(--lt);font-weight:700}
.st td.g{color:var(--grn)}.st td.r{color:var(--red)}
.st tr.me td{background:var(--lt)!important;font-weight:700}
/* bloco texto */
.stx{font-size:15px;line-height:1.65;color:#2a3a35}
.stx p{margin:0 0 16px}
.stx b{color:var(--dk)}
/* capa / divisores */
.slide.dark{background:var(--dk);color:#fff}
.slide.dark2{background:var(--dk2);color:#fff}
.slide .lw{position:absolute;left:56px;top:46px;width:150px}
.slide .tr{position:absolute;right:60px;top:52px;font-size:13px;color:rgba(255,255,255,.85);display:flex;gap:28px}
.slide .bigt{position:absolute;left:68px;font-family:Archivo,Inter,sans-serif;font-weight:400;color:#fff;line-height:1.08}
.slide .kick{color:var(--sg);font-size:15px;letter-spacing:.04em;margin-bottom:12px;font-family:Inter,sans-serif}
.slide .cph{position:absolute;right:70px;width:480px;height:262px;border-radius:20px;background:#244 center/cover;box-shadow:0 10px 30px rgba(0,0,0,.25)}
/* fotos */
.ph3{display:flex;gap:18px;justify-content:center;align-items:flex-start;height:100%}
.ph3 figure{margin:0;flex:1;max-width:372px;display:flex;flex-direction:column;align-items:center}
.ph3 .ft{width:100%;height:390px;border-radius:14px;background:#d9e2df center/cover no-repeat}
.ph3.n1 .ft{height:440px}.ph3.n1 figure{max-width:780px}
.ph3.n2 figure{max-width:520px}
.ph3 figcaption{margin-top:12px;font-size:13px;font-style:italic;font-weight:600;color:#2a3a35;text-align:center}
.cap{position:absolute;left:56px;bottom:26px;display:flex;align-items:center;gap:10px;font-size:13.5px;font-style:italic;font-weight:600;color:#203530;max-width:1000px}
.cap i{width:20px;height:20px;border-radius:50%;background:var(--dk);color:#fff;font-style:normal;font-size:12px;display:flex;align-items:center;justify-content:center;font-weight:700;flex:none}
/* pessoas */
.pp3{display:flex;gap:28px;justify-content:center;height:100%;align-items:flex-start}
.pp3 figure{margin:0;width:300px;display:flex;flex-direction:column;align-items:center}
.pp3 .ft{width:300px;height:400px;border-radius:14px;background:#d9e2df center/cover no-repeat;display:flex;align-items:center;justify-content:center;font-family:Archivo,sans-serif;font-size:72px;color:var(--dk2)}
.pp3 .ft.ini{background:var(--lt)}
.pp3 figcaption{margin-top:12px;font-size:14px;font-weight:600;color:#203530}
.pp3 figcaption span{font-weight:400;color:#53655f}
.pp3.big .ft{width:340px;height:440px}
/* prints */
.pr{display:flex;gap:24px;justify-content:center;align-items:center;height:100%}
.pr .pi{flex:1;height:100%;border-radius:18px;background:#fff;border:1px solid #c9d6d2;display:flex;align-items:center;justify-content:center;padding:16px;overflow:hidden}
.pr .pi img{max-width:100%;max-height:100%;object-fit:contain}
.pr.n1 .pi{max-width:1000px}
/* reputação resumo */
.rep{display:grid;grid-template-columns:420px 1fr;gap:28px;height:100%}
.rcards{display:flex;flex-direction:column;gap:14px}
.rc{background:#dfe8ec;border-radius:12px;padding:16px 18px;display:flex;gap:16px;align-items:center}
.rc .lg{width:52px;height:52px;border-radius:10px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:22px;flex:none;font-family:Archivo,sans-serif}
.rc h6{margin:0 0 3px;font-size:19px;font-weight:500;font-family:Archivo,sans-serif;color:#1d2b27}
.rc p{margin:0;font-size:13px;color:#40524d}
.amp{display:flex;flex-direction:column;gap:14px}
.amp .hd{display:flex;gap:16px;align-items:center}
.amp .hd .lg{width:56px;height:56px;border-radius:12px;background:#F7C21A;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:24px;font-family:Archivo,sans-serif}
.amp h6{margin:0;font-family:Archivo,sans-serif;font-size:22px;font-weight:500}
.amp p{margin:2px 0 0;font-size:12.5px;color:#40524d;max-width:360px}
/* kpis manutenção */
.mk{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-top:8px}
.mk div{background:#fff;border:1px solid #d8e3e0;border-radius:12px;padding:14px 16px}
.mk small{display:block;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:#53655f;font-weight:600;margin-bottom:8px}
.mk b{font-size:28px;font-weight:600;color:var(--dk)}
.mk .o b{color:var(--warn)}.mk .rr b{color:var(--red)}
.ckl{display:grid;grid-template-columns:repeat(2,360px);gap:14px;justify-content:center;margin-top:20px}
.ckl div{background:var(--lt);border-radius:12px;padding:18px 20px;display:flex;gap:14px;align-items:center;font-size:15px;color:var(--dk);font-weight:500;min-height:78px}
.ckl svg{width:26px;height:26px;flex:none;color:var(--dk2)}
.org{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:8px}
.org div{background:#fff;border-radius:10px;padding:12px 14px;border:1px solid #d8e3e0;font-size:13px}
.org div.lead{background:var(--dk);color:#fff;grid-column:1/-1;justify-self:center;min-width:280px;text-align:center}
.org small{display:block;color:#53655f;font-size:11.5px;margin-top:2px}
.org div.lead small{color:var(--sg)}

/* galeria / mapeamento / equipe */
.gal .gthumbs{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:8px;margin-top:14px;max-height:430px;overflow:auto;padding:2px}
.gt{aspect-ratio:4/3;border-radius:8px;background:#e7ecea center/cover no-repeat;cursor:pointer;position:relative;border:3px solid transparent}
.gt.sel{border-color:var(--grn)}
.gt.sel::after{content:"\2713";position:absolute;top:4px;right:4px;width:20px;height:20px;border-radius:50%;background:var(--grn);color:#fff;font-size:12px;display:flex;align-items:center;justify-content:center}
.gt span{position:absolute;left:4px;bottom:4px;background:rgba(10,42,34,.82);color:#fff;font-size:10px;padding:2px 6px;border-radius:4px}
.gt.used{opacity:.6}
.mapt select{width:100%;min-width:260px;border:1px solid var(--line);border-radius:7px;padding:6px 8px;background:#fff}
.mapt tr.miss td{background:#fff5e8}
.warnbox{background:#fff5e8;color:#7a4a00;border-radius:8px;padding:10px 14px;font-size:13px;margin-top:10px}
.slide .eqt{position:absolute;left:0;right:0;top:44px;text-align:center;font-size:19px;letter-spacing:.42em;font-weight:600;color:var(--dk)}
.slide .eqs{position:absolute;left:56px;right:56px;top:112px;bottom:56px}
.eqc{display:flex;align-items:center;gap:14px;border-radius:12px;padding:8px 14px 8px 10px;height:88px;background:#fff;color:#14302a}
.eqc .av{width:70px;height:70px;border-radius:50%;flex:none;background:#cfdcd8 center 22%/cover no-repeat;display:flex;align-items:center;justify-content:center;font-family:Archivo,sans-serif;font-size:24px;color:var(--dk2)}
.eqc b{display:block;font-size:16.5px;font-weight:600;line-height:1.15}
.eqc i{display:block;font-size:12.5px;margin-top:4px;opacity:.85}
.eqc.gg{background:var(--dk);color:#fff}.eqc.gestor{background:var(--dk2);color:#fff}.eqc.sup{background:var(--lt)}.eqc.adm{background:#B5D5DF}
.eqcols{display:flex;gap:10px;justify-content:center;margin-top:18px;align-items:flex-start}
.eqcols>div{display:flex;flex-direction:column;gap:10px}
/* online */
.user{display:flex;align-items:center;gap:10px;font-size:12.5px;color:rgba(255,255,255,.85)}
.sync{font-size:11.5px;padding:4px 9px;border-radius:999px;background:rgba(255,255,255,.1);white-space:nowrap}
.sync.err{background:#B83227;color:#fff}.sync.ok{background:rgba(199,241,197,.18);color:var(--lt)}
.gate{position:fixed;inset:0;background:var(--dk);z-index:60;display:flex;align-items:center;justify-content:center;padding:20px}
.gate .box{background:#fff;border-radius:16px;max-width:460px;width:100%;padding:34px 32px;text-align:center}
.gate img{height:26px;margin-bottom:22px}
.gate h1{font-family:Archivo,sans-serif;font-weight:500;color:var(--dk);font-size:24px;margin:0 0 6px}
.gate p{color:var(--mut);font-size:13.5px;line-height:1.55;margin:0 0 20px}
.gate .btn{width:100%;padding:12px;margin-bottom:10px;font-size:14.5px}
.gate .err{background:#fbe9e7;color:#8a2a1f;border-radius:8px;padding:10px 12px;font-size:13px;margin-bottom:14px;text-align:left}
.gate .alt{margin-top:18px;padding-top:16px;border-top:1px solid var(--line);font-size:12.5px;color:var(--mut)}
.gate .alt .btn{width:auto;padding:8px 12px;font-size:12.5px;margin:6px 3px 0}
.ro{border:0;margin:0;padding:0;min-width:0}
.robar{background:#e9f3f7;color:#1d4a5a;border-radius:10px;padding:12px 16px;margin-bottom:16px;font-size:13px;display:flex;gap:12px;align-items:center}
.robar .btn{margin-left:auto}
.ggrp{display:flex;align-items:center;gap:10px;margin:16px 0 6px;font-size:13px}
.ggrp span{color:var(--mut)}
