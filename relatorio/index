/* ======================= CRM / CompSet / previsão / galeria ======================= */
function parseCRM(text){const lines=[];let abbr=null;const mm=text.match(/Or[çc]ado\s+(Jan|Fev|Mar|Abr|Mai|Jun|Jul|Ago|Set|Out|Nov|Dez)\b/i);if(mm)abbr=mm[1];
 text.split(/\r?\n/).forEach(l=>{if(!l.trim())return;let code='',desc='',nums=[];
  if(l.includes('\t')){const c=l.split('\t').map(x=>x.trim());let k=0;if(/^\d+(\.\d+)*$/.test(c[0])){code=c[0];k=1}else if(c[0]===''){k=1}desc=c[k];if(!desc||!/[A-Za-zÀ-ú]/.test(desc))return;nums=c.slice(k+1).map(parseBR)}
  else{const m=l.trim().match(/^(\d+(?:\.\d+)*)?\s*([^\d\-]+?)\s+(-?\d.*)$/);if(!m)return;code=m[1]||'';desc=m[2].trim();nums=numsIn(m[3])}
  if(nums.filter(n=>n!=null).length<10)return;lines.push({c:code,d:desc,n:nums})});
 return {abbr,lines}}
const lineKey=l=>l.c||norm(l.d);
function matchLine(d,L){const keys=[d.k].concat(d.al||[]).map(norm);return L.find(l=>keys.includes(norm(l.d)))||L.find(l=>keys.some(k=>norm(l.d).startsWith(k)))}
function applyCRM(){const res={ok:0,miss:[]};if(!S.crm)return res;const L=S.crm.lines;
 const run=(grp,defs,mes,ano)=>defs.forEach((d,i)=>{if(d.auto)return;const mk=grp+':'+d.k;const key=S.cfg.map[mk];if(key==='-')return;let ln=key?L.find(l=>lineKey(l)===key):null;
  if(!ln){ln=matchLine(d,L);if(ln)S.cfg.map[mk]=lineKey(ln)}
  if(!ln){res.miss.push(d.k);return}res.ok++;const n=ln.n;Object.assign(S.ger[mes][i],{orc:n[0],real:n[1],ant:n[2]});Object.assign(S.ger[ano][i],{orc:n[7],real:n[8],ant:n[9]})});
 run('dre',DRE_ROWS,'dreMes','dreAno');run('desp',DESP_ROWS,'despMes','despAno');return res}
function mapCard(){const L=S.crm.lines;
 const opts=v=>`<option value="" disabled ${!v?'selected':''}>Escolha a linha do CRM…</option><option value="-" ${v==='-'?'selected':''}>— não usar —</option>`+L.map(l=>`<option value="${esc(lineKey(l))}" ${v===lineKey(l)?'selected':''}>${esc((l.c?l.c+'   ':'')+l.d)}</option>`).join('');
 const rows=(grp,defs,mes)=>defs.filter(d=>!d.auto).map((d,i)=>{const mk=grp+':'+d.k;const v=S.cfg.map[mk];const ok=v==='-'||(v&&L.some(l=>lineKey(l)===v));const r=S.ger[mes][i];const f=d.t==='pct'?(n=>n==null?'—':nf2.format(n)+'%'):brl;
  return `<tr class="${ok?'':'miss'}"><td class="lb">${d.k}</td><td><select data-map="${esc(mk)}">${opts(ok?v:'')}</select></td><td class="cv">${ok&&v!=='-'?f(r.real):'—'}</td></tr>`}).join('');
 const sep=t=>`<tr><td colspan="3" style="padding-top:14px;font-size:11px;letter-spacing:.06em;color:var(--mut);font-weight:600">${t}</td></tr>`;
 return `<div class="card mapt"><h3>Correspondência de linhas</h3><p class="sub">${L.length} linhas lidas${S.crm.abbr?` (mês da colagem: ${esc(S.crm.abbr)})`:''}. Confira se cada linha do relatório puxou a linha certa do CRM. Isso se faz uma vez só: o sistema guarda a escolha e usa nos próximos meses.</p><table class="tb"><thead><tr><th>Linha do relatório</th><th>Linha do CRM</th><th>Realizado no mês</th></tr></thead><tbody>${sep('DESEMPENHO')}${rows('dre',DRE_ROWS,'dreMes')}${sep('DESPESAS')}${rows('desp',DESP_ROWS,'despMes')}</tbody></table></div>`}
function parseCSAll(text){const res={cs1:null,cs2:null,ref1:'',ref2:''};let cur='cs1';const MRE=/(janeiro|fevereiro|mar[çc]o|abril|maio|junho|julho|agosto|setembro|outubro|novembro|dezembro)\s*(?:\/|de|-)?\s*(\d{4})/i;
 text.split(/\r?\n/).forEach(l=>{const t=l.trim();if(!t)return;
  if(/compset|r2|desempenho|concorrent/i.test(t)&&numsIn(t).length<4){cur=/\br2\b|laghetto/i.test(t)?'cs2':'cs1';const m=t.match(MRE);if(m)res[cur==='cs1'?'ref1':'ref2']=m[1][0].toUpperCase()+m[1].slice(1).toLowerCase()+' '+m[2];return}
  const r=parseCS(t);if(r.length)(res[cur]=res[cur]||[]).push(r[0])});return res}
function pDays(i){const m0=S.mes+i;return new Date(S.ano+Math.floor(m0/12),(m0%12)+1,0).getDate()}
function prevCalc(i){const p=S.ger.prev[i];const u=S.cfg.uhs||0,d=pDays(i);const rev=[0,1].map(j=>p.occ[j]!=null&&p.adr[j]!=null?p.occ[j]/100*p.adr[j]:null);return {occ:p.occ,adr:p.adr,rev,rec:rev.map(r=>r==null?null:r*u*d),d}}
function refreshPrev(){S.ger.prev.forEach((p,i)=>{const c=prevCalc(i);['occ','adr','rev','rec'].forEach(k=>{const a=c[k];const d=a[0]?(a[1]/a[0]-1)*100:NaN;const el=document.getElementById(`pv${i}${k}d`);if(el){el.textContent=pct(d);el.className='cv '+(d<0?'bad':d>0?'good':'')}
 if(k==='rev'||k==='rec')[0,1].forEach(j=>{const x=document.getElementById(`pv${i}${k}${j}`);if(x)x.textContent=brl(a[j])})})})}
function usedIds(k){const s=new Set();const add=bl=>bl.forEach(b=>b.f.forEach(x=>s.add(x.id)));if(k==='man')add(S.ger.man.bl);else{add(S.guest.cli);add(S.guest.evt)}return s}
let GAL={man:null,guest:null},GALST={man:'',guest:''};
const MRE=(m,a)=>{const n=norm(MESES[m-1]),mm=String(m).padStart(2,'0');return {top:x=>{const t=norm(x.name);return x.name.trim().startsWith(`${a}-${mm}`)||x.name.trim().startsWith(`${a}${mm}`)||(t.includes(n)&&t.includes(String(a)))},sub:x=>{const t=norm(x.name);return new RegExp('^0?'+m+'(\\b|[^0-9])').test(x.name.trim())||t.startsWith(n)||t.includes(n)}}};
async function findMonthFolder(root){const r=MRE(S.mes,S.ano);const L1=(await dList(`'${root}' in parents and mimeType='${FOLDER}' and trashed=false`)).filter(x=>x.name!==CFG.PASTA_DADOS);
 let f=L1.find(r.top);if(f)return {id:f.id,name:f.name};const y=L1.find(x=>x.name.trim()===String(S.ano));
 if(y){const L2=await dList(`'${y.id}' in parents and mimeType='${FOLDER}' and trashed=false`);f=L2.find(r.sub);if(f)return {id:f.id,name:y.name+' / '+f.name}}return null}
async function listImgs(fid,grp,depth){const it=await dList(`'${fid}' in parents and trashed=false`);it.sort((a,b)=>a.name.localeCompare(b.name,'pt',{numeric:true}));let out=[];
 for(const x of it){if(x.mimeType===FOLDER){if(depth<3)out=out.concat(await listImgs(x.id,grp?grp+' / '+x.name:x.name,depth+1))}else if(/^image\//.test(x.mimeType))out.push({id:'d:'+x.id,name:x.name,thumb:(x.thumbnailLink||'').replace(/=s\d+$/,'=s400'),grp})}return out}
async function loadGal(k){if(MODE!=='drive')return;GAL[k]=[];GALST[k]='Procurando a pasta do mês no Drive…';softRender();
 try{const root=k==='man'?CFG.PASTA_FOTOS_MANUTENCAO:CFG.PASTA_FOTOS_GUEST;const mf=await findMonthFolder(root);
  if(!mf){GALST[k]=`Não encontrei a pasta de ${MESES[S.mes-1]} ${S.ano}. Crie no Drive uma subpasta chamada ${S.ano}-${String(S.mes).padStart(2,'0')}-${MESES[S.mes-1]} e clique em Atualizar.`;softRender();return}
  GAL[k]=await listImgs(mf.id,'',0);GALST[k]=`Pasta do Drive: ${mf.name} · ${GAL[k].length} foto(s)`}catch(e){GALST[k]='Erro ao ler o Drive: '+e.message}softRender()}
function relThumb(el){const id=el.dataset.id;el.onerror=null;loadImg(id).then(()=>{if(IMG[id])el.src=IMG[id]})}
const GSEL={man:new Set(),guest:new Set()};
function galleryBox(k){if(MODE==='drive'&&GAL[k]===null)setTimeout(()=>loadGal(k),0);const g=GAL[k]||[];const u=usedIds(k);
 const groups=[];g.forEach(x=>{let gr=groups.find(y=>y.n===x.grp);if(!gr){gr={n:x.grp,a:[]};groups.push(gr)}gr.a.push(x)});
 const th=x=>`<div class="gt ${GSEL[k].has(x.id)?'sel':''} ${u.has(x.id)?'used':''}" draggable="true" data-act="galSel" data-k="${k}" data-gid="${x.id}" title="${esc(x.name||'')}"><img loading="lazy" data-id="${x.id}" src="${esc(IMG[x.id]||x.thumb||'')}" onerror="relThumb(this)" ${!IMG[x.id]&&!x.thumb?'data-lazy="1"':''}>${u.has(x.id)?'<span>no relatório</span>':''}</div>`;
 const dest=k==='man'?'ger.man.bl':'guest.cli';
 return `<div class="card gal"><h3>Galeria do mês</h3><p class="sub">${MODE==='drive'?'Fotos da pasta do mês no Drive, separadas por subpasta. Clique nas fotos (na ordem que quiser) e use <b>Adicionar selecionadas</b> no bloco, arraste uma foto para o bloco, ou crie um bloco com a subpasta inteira.':'Abra a pasta do mês no computador. Clique nas fotos para selecionar e use <b>Adicionar selecionadas</b> no bloco, ou arraste para o bloco.'}</p>
 <div class="row" style="align-items:center">${MODE==='drive'?`<button class="btn ghost" data-act="galReload" data-k="${k}">Atualizar</button>`:`<label class="btn">Abrir pasta do mês<input type="file" webkitdirectory multiple hidden data-gal="${k}"></label><label class="btn ghost">Escolher fotos<input type="file" multiple accept="image/*" hidden data-gal="${k}"></label>`}<span class="hint" style="margin:0">${esc(GALST[k]||'')} · <span id="galCnt-${k}">${GSEL[k].size}</span> selecionada(s)</span></div>
 ${groups.map((gr,gi)=>`<div class="ggrp"><b>${esc(gr.n||'Pasta do mês')}</b><span>${gr.a.length} foto(s)</span><button class="btn lt sm" data-act="galBlock" data-k="${k}" data-g="${gi}" data-dest="${dest}">Criar bloco com estas fotos</button></div><div class="gthumbs" style="margin-top:4px;max-height:none">${gr.a.map(th).join('')}</div>`).join('')}</div>`}
async function loadGallery(k,fl){const files=[...fl].filter(f=>f.type.startsWith('image/')).sort((a,b)=>(a.webkitRelativePath||a.name).localeCompare(b.webkitRelativePath||b.name,'pt',{numeric:true}));
 GAL[k]=GAL[k]||[];for(let i=0;i<files.length;i++){setSync(`Carregando ${i+1} de ${files.length}…`);const d=await shrink(files[i]);if(!d)continue;const id=uid();idbPut(id,d);const pth=(files[i].webkitRelativePath||'').split('/');GAL[k].push({id,name:files[i].name,thumb:'',grp:pth.length>2?pth.slice(1,-1).join(' / '):''})}
 GALST[k]=`${GAL[k].length} foto(s)`;setSync('');render()}
/* ---- números da manutenção (Supabase do ERPPA) ---- */
async function pullMan(){const mm=String(S.mes).padStart(2,'0');const ini=`${S.ano}-${mm}-01`;const nx=S.mes===12?`${S.ano+1}-01-01`:`${S.ano}-${String(S.mes+1).padStart(2,'0')}-01`;
 setSync('Buscando chamados da Manutenção…');
 try{const r=await fetch(`${CFG.SUPA_URL}/rest/v1/chamados?select=status,prioridade,criadoEm,concluidoEm,reaberturas&criadoEm=gte.${ini}&criadoEm=lt.${nx}`,{headers:{apikey:CFG.SUPA_KEY,Authorization:'Bearer '+CFG.SUPA_KEY}});
  if(!r.ok)throw new Error('HTTP '+r.status);const a=await r.json();const c=a.filter(x=>x.status==='Concluido');
  const t=c.map(x=>new Date(x.concluidoEm)-new Date(x.criadoEm)).filter(x=>x>0);const av=t.length?t.reduce((s,x)=>s+x,0)/t.length:0;const h=Math.floor(av/3600000),mi=Math.round((av%3600000)/60000);
  Object.assign(S.ger.man,{ab:a.length,co:c.length,ur:a.filter(x=>x.prioridade==='Urgente').length,re:a.reduce((s,x)=>s+Number(x.reaberturas||0),0),tm:t.length?`${h}h${String(mi).padStart(2,'0')}min`:''});
  save();render();setSync(`${a.length} chamados de ${MESES[S.mes-1]} lidos da Manutenção`,'ok')}catch(e){setSync('Erro ao buscar chamados: '+e.message,'err')}}
